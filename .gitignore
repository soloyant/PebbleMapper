# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.venv/
venv/

# Editors and OS
.idea/
.vscode/
.ipynb_checkpoints/
.DS_Store
Thumbs.db

# Trained model weights: distributed through Zenodo, see README §4
model_weights/*.h5
*.h5


# Any other project placed under datasets/ is the user's field data, never versioned
datasets/*
!datasets/example_01_orthorectification/
!datasets/example_02_quadrat_detection/
!datasets/example_03_Etretat/
# The example ships its detection CSVs and rasters (so Rasterize, Map, Zonal and Report
# run at once); maps, figures, reports and logs are regenerated by the app.
datasets/example_03_Etretat/output_results/maps/
datasets/example_03_Etretat/output_results/figures/
datasets/example_03_Etretat/output_results/reports/
datasets/example_03_Etretat/output_results/logs/
datasets/example_03_Etretat/output_results/vectors/checkpoints/
datasets/example_03_Etretat/output_results/vectors/*.run.*
!datasets/example_04_gauge_scale/
# The caliper set ships its detections and truth files; what Validate writes is regenerated.
# The paper's validation set: the same, for the 105 pebbles of Soloy et al. (2020).
!datasets/example_06_paper_validation/
datasets/example_06_paper_validation/output_results/maps/
datasets/example_06_paper_validation/output_results/figures/
datasets/example_06_paper_validation/output_results/reports/
datasets/example_06_paper_validation/output_results/logs/
datasets/example_06_paper_validation/output_results/vectors/checkpoints/
datasets/example_06_paper_validation/output_results/vectors/*.run.*
datasets/example_06_paper_validation/validation/results/*/

# Files the app writes while running (the README's own figures under
# docs/figures/ are documentation, not output, and stay tracked)
results/
figures/
!docs/figures/
!docs/figures/**
*.log
*.tmp
user_detectors.json

# The caliper set's ground-truth table lives in validation/results/, which the rule
# above hides; keep that one file, not what Validate writes beside it.
!datasets/example_06_paper_validation/validation/results/
datasets/example_06_paper_validation/validation/results/*/
